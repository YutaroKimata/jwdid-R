\name{gravity}
\alias{gravity}
\docType{data}
\title{Simulated Bilateral Trade Panel}
\description{
A simulated panel of bilateral trade with staggered regional trade agreement adoption.
}
\usage{data(gravity)}
\format{
A data frame with 2880 observations and 8 variables:
\describe{
\item{exporter}{Exporter identifier, from 1 to 16.}
\item{importer}{Importer identifier, from 1 to 16.}
\item{year}{Year, from 2000 to 2011.}
\item{first_year}{First agreement year: 2003, 2006 or 2009; zero for never-treated dyads.}
\item{rta}{One if an agreement is in effect, zero otherwise.}
\item{trade}{Simulated nonnegative trade flow.}
\item{tau}{True agreement effect on the log conditional mean.}
\item{mu}{True conditional mean of trade.}
}
}
\source{Simulated data generated by \file{data-raw/generate_gravity.R}.}
\seealso{\code{\link{jwdid}}}
\keyword{datasets}
